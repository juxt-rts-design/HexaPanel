# Uniquement ce qui se régénère (évite un push de ~350 Mo)
node_modules/
**/node_modules/

# Builds (npm run build)
dist/
**/dist/
build/
.turbo/
.vite/
coverage/

# Données runtime VPS — ne jamais écraser via git pull
data/*.db
data/*.db-journal
data/uploads/
apps-data/**
!apps-data/.gitkeep
!data/.gitkeep

# Logs / OS
*.log
.DS_Store
Thumbs.db

# Gros archives temporaires
*.zip
